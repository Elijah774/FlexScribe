# FlexScribe Server Configuration
# SQL Server connection (Windows Authentication)
DB_SERVER=localhost
DB_NAME=FlexScribeDB
DB_TRUSTED=true
# If using SQL Server Authentication instead, set:
# DB_USER=your_username
# DB_PASSWORD=your_password
# DB_TRUSTED=false

# Server
PORT=3000
JWT_SECRET=flexscribe_jwt_secret_change_in_production
