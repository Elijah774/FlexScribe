# FlexScribe Server Configuration
# SQL Server connection (SQL Server Authentication)
DB_SERVER=localhost
DB_NAME=FlexScribeDB
DB_USER=FlexScribeApp
DB_PASSWORD=FlexScribe123!
DB_TRUSTED=false

# Server
PORT=3000
JWT_SECRET=flexscribe_jwt_secret_change_in_production

# ── Dependant invitations / email (all OPTIONAL) ──
# If SMTP_HOST is unset, invitation emails are written to server/_sent-emails.log
# (dev mode) instead of being sent — the full invitation flow still works.
# To send real email, install nodemailer (npm i nodemailer) and set these:
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM=FlexScribe <no-reply@yourdomain.com>
# APP_BASE_URL=http://localhost:3000     # public base used to build setup links
# INVITE_EXPIRY_HOURS=72                  # invitation validity window (default 72)
