# FlexScribe Server Configuration
# ── Windows Authentication (lab machine — TCP/IP disabled) ──
# Leave DB_USER blank to use Windows Auth via Shared Memory (lpc:).
# The msnodesqlv8 driver handles this without needing TCP port 1433.
DB_SERVER=localhost
DB_NAME=FlexScribeDB
DB_USER=
DB_PASSWORD=

# ── SQL Server Authentication (remote / TCP-enabled machine) ──
# Uncomment and fill in these to switch to SQL Auth:
# DB_USER=FlexScribeApp
# DB_PASSWORD=FlexScribe123!

# Server
PORT=3000
JWT_SECRET=flexscribe_jwt_secret_change_in_production
