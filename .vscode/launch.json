{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "FlexScribe Server",
            "program": "${workspaceFolder}/server/server.js",
            "cwd": "${workspaceFolder}/server"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Open MASTER.html",
            "url": "http://localhost:3000/pages/MASTER.html"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "FlexScribe Backend",
            "program": "${workspaceFolder}/server/server.js",
            "cwd": "${workspaceFolder}/server",
            "envFile": "${workspaceFolder}/server/.env",
            "serverReadyAction": {
                "pattern": "running on http://localhost:([0-9]+)",
                "uriFormat": "http://localhost:%s/landing.html",
                "action": "openExternally"
            }
        }
    ],
    "compounds": [
        {
            "name": "Run FlexScribe",
            "configurations": ["FlexScribe Backend"]
        }
    ]
}
