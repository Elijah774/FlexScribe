# FlexScribe Server Configuration
# This machine uses SQL Server Authentication over TCP (port 1433).
# db.js auto-selects SQL Auth whenever DB_USER is set; leave DB_USER blank
# to fall back to Windows Authentication (Shared Memory) on lab machines.
DB_SERVER=localhost
DB_NAME=FlexScribeDB
DB_USER=FlexScribeApp
DB_PASSWORD=FlexScribe123!
DB_TRUSTED=false

# Server
PORT=3000
JWT_SECRET=flexscribe_jwt_secret_change_in_production
